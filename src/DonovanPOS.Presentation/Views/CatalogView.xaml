<UserControl x:Class="DonovanPOS.Presentation.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button Content="Agregar producto" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Exportar Excel" Command="{Binding ExportCommand}" Margin="8,0,0,0"/><Button Content="Importar Excel" Command="{Binding ImportCommand}" Margin="8,0,0,0"/><Button Content="Plantilla" Command="{Binding TemplateCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></WrapPanel><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" AutomationProperties.Name="Buscar productos" ToolTip="Descripción, código, marca o categoría"/></DockPanel><WrapPanel Margin="0,12,0,0"><Button Content="Editar producto" Command="{Binding EditCommand}" Margin="0,0,8,0"/><Button Content="Ajustar existencias" Command="{Binding AdjustCommand}" Margin="0,0,8,0"/><Button Content="Movimientos" Command="{Binding MovementsCommand}" Margin="0,0,8,0"/><Button Content="Archivar / reactivar" Command="{Binding ArchiveCommand}" Style="{StaticResource QuietButton}"/><CheckBox Content="Mostrar archivados" IsChecked="{Binding ShowArchived}" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><Grid><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="Clave" Binding="{Binding Sku}" Width="100"/><DataGridTemplateColumn Header="Producto" Width="*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Brand}" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="115"/><DataGridTextColumn Header="Existencia" Binding="{Binding StockLabel}" Width="110"/><DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="95"/><DataGridTextColumn Header="Estado" Binding="{Binding StockStatus}" Width="130"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Un catálogo listo para tu negocio" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Agrega tu primer producto o importa tu catálogo desde Excel." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Grid></Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="← Anterior" Command="{Binding PreviousCommand}"/><Button Content="Siguiente →" Command="{Binding NextCommand}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding CountLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>
