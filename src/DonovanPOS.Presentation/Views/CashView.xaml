<UserControl x:Class="DonovanPOS.Presentation.Views.CashView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/><Button Content="Abrir caja" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding Opened, Converter={StaticResource Not}}"/></StackPanel><StackPanel><TextBlock Text="Caja" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#102D36" Padding="22" CornerRadius="8" Margin="0,0,12,0"><StackPanel><TextBlock Text="EFECTIVO ESPERADO" Foreground="#91B9C3" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Expected}" FontSize="35" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Fondo inicial" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Opening}" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Entradas de efectivo" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Incomes}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Salidas de efectivo" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Expenses}" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border></Grid>
  <TabControl Grid.Row="2"><TabItem Header="Movimientos de la caja abierta"><DataGrid ItemsSource="{Binding Movements}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding A}" Width="70"/><DataGridTextColumn Header="Tipo" Binding="{Binding B}" Width="115"/><DataGridTextColumn Header="Folio" Binding="{Binding C}" Width="115"/><DataGridTextColumn Header="Importe" Binding="{Binding D}" Width="115"/><DataGridTextColumn Header="Motivo" Binding="{Binding E}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Historial de cierres"><DataGrid ItemsSource="{Binding History}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding A}" Width="110"/><DataGridTextColumn Header="Cierre" Binding="{Binding B}" Width="*"/><DataGridTextColumn Header="Esperado" Binding="{Binding C}" Width="130"/><DataGridTextColumn Header="Contado" Binding="{Binding D}" Width="130"/><DataGridTextColumn Header="Diferencia" Binding="{Binding E}" Width="130"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
  <DockPanel Grid.Row="3" Margin="0,18,0,0"><Button Content="Cerrar caja" Command="{Binding CloseCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" IsEnabled="{Binding Opened}" Margin="12,0,0,0"/><Button Content="Registrar ingreso / egreso" Command="{Binding MovementCommand}" DockPanel.Dock="Right" IsEnabled="{Binding Opened}"/><TextBlock Text="Las ventas a crédito no aumentan el efectivo.&#10;Los abonos en efectivo sí se suman a esta caja." Style="{StaticResource MutedText}" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>
