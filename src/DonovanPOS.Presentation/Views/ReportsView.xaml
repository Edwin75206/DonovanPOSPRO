<UserControl x:Class="DonovanPOS.Presentation.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Exportar Excel" Command="{Binding ExcelCommand}" Margin="0,0,10,0"/><Button Content="Generar PDF" Command="{Binding PdfCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel><StackPanel><TextBlock Text="Reportes" Style="{StaticResource PageTitle}"/><TextBlock Text="Información clara para tomar mejores decisiones." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16"><WrapPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="Qué quieres consultar" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" Width="210"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Desde" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><DatePicker SelectedDate="{Binding From}" Width="140"/></StackPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="Hasta" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><DatePicker SelectedDate="{Binding To}" Width="140"/></StackPanel><Button Content="Consultar" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}"/></WrapPanel></Border>
  <TextBlock Grid.Row="2" Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,18,0,12"/>
  <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0"><DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True"/></Border>
 </Grid>
</UserControl>
