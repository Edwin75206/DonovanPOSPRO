<UserControl x:Class="DonovanPOS.Presentation.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#102D36" Padding="44"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Background="#26A8AA" Width="42" Height="42" CornerRadius="7"><TextBlock Text="D" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="DONOVAN" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="POS PRO" Foreground="#8CAEB8" FontSize="11"/></StackPanel></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><Border Height="4" Width="44" Background="#C9A65B" HorizontalAlignment="Left" Margin="0,0,0,25"/><TextBlock Text="Todo en su lugar.&#10;Tu negocio,&#10;en tus manos." Foreground="White" FontSize="38" FontWeight="SemiBold" LineHeight="47"/><TextBlock Text="Vende con agilidad. Conoce tu inventario.&#10;Cierra cada día con claridad." Foreground="#ADC7CE" FontSize="15" LineHeight="25" Margin="0,25,0,0"/><Border Background="#1B414C" CornerRadius="7" Padding="16" Margin="0,35,0,0"><TextBlock Text="Tu información se guarda en esta computadora. Puedes trabajar sin conexión a internet." Foreground="#C3DCE2" FontSize="12" LineHeight="19"/></Border></StackPanel><TextBlock Grid.Row="2" Text="DONOVAN SYSTEMS     /     HECHO PARA TU NEGOCIO" Foreground="#86A9B3" FontSize="10"/></Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="390" Margin="38,40" VerticalAlignment="Center"><TextBlock Text="TU FERRETERÍA, ORGANIZADA" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,18"/><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Accede con tu cuenta para comenzar." Style="{StaticResource MutedText}" Margin="0,10,0,24"/>
   <StackPanel Visibility="{Binding Setup, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Nombre de la ferretería" Margin="0,0,0,6"/><TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre de la ferretería" Margin="0,0,0,14"/><TextBlock Text="Tu nombre" Margin="0,0,0,6"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre del administrador" Margin="0,0,0,14"/></StackPanel>
   <TextBlock Text="Usuario" Margin="0,0,0,6"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuario" Margin="0,0,0,14"/><TextBlock Text="Contraseña" Margin="0,0,0,6"/><PasswordBox x:Name="Password" PasswordChanged="PasswordChanged" AutomationProperties.Name="Contraseña" Margin="0,0,0,14"/>
   <StackPanel Visibility="{Binding Setup, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Confirmar contraseña" Margin="0,0,0,6"/><PasswordBox x:Name="Confirmation" PasswordChanged="PasswordChanged" AutomationProperties.Name="Confirmar contraseña"/><TextBlock Text="Usa al menos 10 caracteres. Esta será tu cuenta de administrador." Style="{StaticResource MutedText}" Margin="0,8,0,14"/></StackPanel>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" Margin="0,4,0,12"/><Button Content="{Binding ActionText}" Command="{Binding SubmitCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinHeight="42" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/><ProgressBar Height="3" IsIndeterminate="True" Margin="0,8" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
   <TextBlock Text="Donovan POS Pro · 1.0" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
