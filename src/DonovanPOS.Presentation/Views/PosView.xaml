<UserControl x:Class="DonovanPOS.Presentation.Views.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.InputBindings><KeyBinding Key="F8" Command="{Binding CheckoutCommand}"/><KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/><KeyBinding Key="F6" Command="{Binding ChangeQuantityCommand}"/></UserControl.InputBindings>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Ticket PDF" Command="{Binding TicketPdfCommand}" Visibility="{Binding HasReceipt, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Content="Imprimir ticket" Command="{Binding PrintCommand}" Visibility="{Binding HasReceipt, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Content="Nueva venta" Command="{Binding ClearCommand}"/></StackPanel><StackPanel><TextBlock Text="Punto de venta" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding QuoteLabel}" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.95*" MinWidth="305"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="16"><StackPanel><TextBlock Text="Buscar o escanear producto" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar o escanear producto" FontSize="16" Height="42"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings></TextBox><TextBlock Text="Descripción, clave, código de barras, marca o categoría" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
    <TextBlock Grid.Row="1" Text="CATÁLOGO  /  Selecciona un producto" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,18,0,10"/>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><Grid><DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" MouseDoubleClick="ProductDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="155"/><DataGridTextColumn Header="Disponible" Binding="{Binding StockLabel}" Width="105"/><DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="92"/></DataGrid.Columns></DataGrid><TextBlock Text="Sin resultados. Prueba otra búsqueda o agrega productos al catálogo." Margin="25" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Products.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="14" Margin="0,12,0,0"><DockPanel><Button Content="Agregar a la venta  ↵" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="12,0,0,0" IsEnabled="{Binding QuoteLocked, Converter={StaticResource Not}}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="75" AutomationProperties.Name="Cantidad a agregar"/></StackPanel></DockPanel></Border>
   </Grid>
   <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding CountLabel}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Text="Venta actual" Style="{StaticResource SectionTitle}"/></DockPanel>
    <ComboBox Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Margin="0,0,0,12" AutomationProperties.Name="Cliente de la venta"/>
    <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedLine}" RowHeight="54"><DataGrid.Columns><DataGridTemplateColumn Header="Producto" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UnitLabel}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cant." Binding="{Binding Quantity, StringFormat=0.####}" Width="60"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="85"/></DataGrid.Columns></DataGrid><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="20"><TextBlock Text="Tu próxima venta comienza aquí" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Busca un producto o escanea su código." Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
    <WrapPanel Grid.Row="3" Margin="0,8,0,10"><Button Content="Cantidad · F6" Command="{Binding ChangeQuantityCommand}" Style="{StaticResource QuietButton}"/><Button Content="Quitar" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}"/><Button Content="Descuento" Command="{Binding DiscountCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding CanDiscount, Converter={StaticResource BoolVisibility}}"/></WrapPanel>
    <StackPanel Grid.Row="4"><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel><DockPanel Margin="0,0,0,7"><TextBlock Text="{Binding Subtotal, StringFormat={}{0:C2}}" DockPanel.Dock="Right"/><TextBlock Text="Subtotal" Style="{StaticResource MutedText}"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding Tax, StringFormat={}{0:C2}}" DockPanel.Dock="Right"/><TextBlock Text="IVA incluido" Style="{StaticResource MutedText}"/></DockPanel><DockPanel Margin="0,6,0,16"><TextBlock Text="{Binding Total, StringFormat={}{0:C2}}" DockPanel.Dock="Right" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Total MXN" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></StackPanel></Border><Button Content="Cobrar venta   F8" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryButton}" Height="44" IsEnabled="{Binding IsEmpty, Converter={StaticResource Not}}"/><Button Content="Guardar como cotización" Command="{Binding SaveQuoteCommand}" Style="{StaticResource QuietButton}" Margin="0,6,0,0"/></StackPanel>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
