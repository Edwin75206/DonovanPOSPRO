<UserControl x:Class="DonovanPOS.Presentation.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <DockPanel Margin="0,0,0,22"><Button Content="Registrar venta   →" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="pos" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock Text="RESUMEN DEL NEGOCIO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,7"/><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="Lo que necesitas saber para comenzar el día." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <UniformGrid Columns="4" Margin="0,0,0,20">
   <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Ventas de hoy" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Today}" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{Binding Week}" FontSize="10" Foreground="{DynamicResource Accent}"/></StackPanel></Border>
   <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Operaciones de hoy" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Data.TodayCount, FallbackValue=0}" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{Binding Month}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
   <Border Style="{StaticResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Efectivo en caja" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Cash}" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Saldo esperado · caja abierta" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
   <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Pendiente de cobro" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Credit}" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Crédito otorgado a clientes" FontSize="10" Foreground="{DynamicResource Gold}"/></StackPanel></Border>
  </UniformGrid>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,18,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="7 días" Command="{Binding PeriodPresetCommand}" CommandParameter="7" Style="{StaticResource QuietButton}"/><Button Content="Este mes" Command="{Binding PeriodPresetCommand}" CommandParameter="month" Style="{StaticResource QuietButton}"/></StackPanel><TextBlock Text="Comportamiento de ventas" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,14,0,6"><TextBlock Text="{Binding Period}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Comparison}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
    <WrapPanel Margin="0,8,0,8"><DatePicker SelectedDate="{Binding From}" Width="130" AutomationProperties.Name="Desde"/><TextBlock Text="a" Margin="10,0" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding To}" Width="130" AutomationProperties.Name="Hasta"/><Button Content="Aplicar" Command="{Binding RefreshCommand}" Margin="10,0,0,0"/></WrapPanel>
    <Grid Height="230"><charts:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" AnimationsSpeed="{Binding AnimationSpeed}" TooltipPosition="Top"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}" Margin="0,0,0,25"><TextBlock Text="Aquí verás crecer tus ventas" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="Registra tu primera venta para comenzar." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Grid><TextBlock Text="Ventas menos devoluciones registradas en el período · MXN" Style="{StaticResource MutedText}" FontSize="10"/>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Los más vendidos" Style="{StaticResource SectionTitle}"/><TextBlock Text="Por importe de venta original" Style="{StaticResource MutedText}" Margin="0,5,0,18"/><ItemsControl ItemsSource="{Binding Data.TopProducts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,15"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Value, StringFormat={}{0:C2}}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,4,0,5"/><ProgressBar Height="4" Maximum="{Binding DataContext.TopMax, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{Binding Value}" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,8,0,0"><StackPanel><TextBlock Text="Ganancia bruta estimada" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Profit}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="Venta sin IVA menos costo registrado. No incluye gastos del negocio." Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border></StackPanel></Border>
  </Grid>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,18,0"><StackPanel><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Ver historial →" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="history" Style="{StaticResource QuietButton}"/><TextBlock Text="Últimas ventas" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><DataGrid ItemsSource="{Binding Data.Recent}" MaxHeight="290"><DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="100"/><DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding TotalCents, Converter={StaticResource Money}}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock Text="Todavía no hay ventas registradas." Margin="0,16" Foreground="{DynamicResource Muted}" Visibility="{Binding NoRecent, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><DockPanel Margin="0,0,0,16"><Button Content="Ver inventario →" DockPanel.Dock="Right" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="inventory" Style="{StaticResource QuietButton}"/><TextBlock Text="Por reabastecer" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Data.LowStock}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,15"><Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="8,4"><TextBlock Text="{Binding StockLabel}" Foreground="{DynamicResource Gold}" FontSize="11" FontWeight="SemiBold"/></Border><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Sku}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Sin productos por debajo del mínimo." Foreground="{DynamicResource Muted}" Visibility="{Binding NoLowStock, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}" Margin="0,0,18,0"><StackPanel><TextBlock Text="Ventas por categoría" Style="{StaticResource SectionTitle}"/><charts:PieChart Height="240" Series="{Binding CategorySeries}" LegendPosition="Right" AnimationsSpeed="{Binding AnimationSpeed}"/><TextBlock Text="Importes originales del período" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Métodos de pago" Style="{StaticResource SectionTitle}"/><charts:PieChart Height="240" Series="{Binding MethodSeries}" LegendPosition="Right" AnimationsSpeed="{Binding AnimationSpeed}"/><TextBlock Text="Pagos de ventas; crédito representa cuentas por cobrar" Style="{StaticResource MutedText}"/></StackPanel></Border></Grid>
 </StackPanel></ScrollViewer>
</UserControl>

