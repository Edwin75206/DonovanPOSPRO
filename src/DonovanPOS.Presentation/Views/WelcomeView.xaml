<UserControl x:Class="DonovanPOS.Presentation.Views.WelcomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#0C2732" Padding="44"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Background="#00CFCB" Width="42" Height="42" CornerRadius="9"><TextBlock Text="D" Foreground="#0C2732" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="DONOVAN" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="POS PRO" Foreground="#8CAEB8" FontSize="11"/></StackPanel></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><Border Height="4" Width="44" Background="#E6AD15" HorizontalAlignment="Left" Margin="0,0,0,25"/><TextBlock Text="Todo en su lugar.&#10;Tu negocio,&#10;en tus manos." Foreground="White" FontSize="38" FontWeight="SemiBold" LineHeight="47"/><TextBlock Text="Vende con agilidad. Conoce tu inventario.&#10;Cierra cada día con claridad." Foreground="#ADC7CE" FontSize="15" LineHeight="25" Margin="0,25,0,0"/><Border Background="#1B414C" CornerRadius="10" Padding="18" Margin="0,35,0,0"><TextBlock Text="Tu información se guarda en esta computadora. Puedes trabajar sin conexión a internet." Foreground="#C3DCE2" FontSize="12" LineHeight="19"/></Border></StackPanel><TextBlock Grid.Row="2" Text="DONOVAN SYSTEMS  /  HECHO PARA TU NEGOCIO" Foreground="#86A9B3" FontSize="10"/></Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="405" Margin="36,60" VerticalAlignment="Center"><TextBlock Text="{Binding StepLabel}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,18"/><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,10,0,26"/>
   <StackPanel Visibility="{Binding CommerceStep, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Nombre de la ferretería" Margin="0,0,0,7"/><TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre de la ferretería" Margin="0,0,0,18"/><TextBlock Text="Dirección (opcional)" Margin="0,0,0,7"/><TextBox Text="{Binding Preferences.Address}" Margin="0,0,0,18"/><TextBlock Text="Teléfono (opcional)" Margin="0,0,0,7"/><TextBox Text="{Binding Preferences.Phone}" Margin="0,0,0,18"/><TextBlock Text="RFC (opcional)" Margin="0,0,0,7"/><TextBox Text="{Binding Preferences.TaxId}"/></StackPanel>
   <StackPanel Visibility="{Binding AccountStep, Converter={StaticResource BoolVisibility}}"><StackPanel Visibility="{Binding Setup, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Tu nombre" Margin="0,0,0,7"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre del administrador" Margin="0,0,0,18"/></StackPanel><TextBlock Text="Usuario" Margin="0,0,0,7"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuario" Margin="0,0,0,18"/><TextBlock Text="Contraseña" Margin="0,0,0,7"/><PasswordBox x:Name="Password" PasswordChanged="PasswordChanged" AutomationProperties.Name="Contraseña" Margin="0,0,0,18"/><StackPanel Visibility="{Binding Setup, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Confirmar contraseña" Margin="0,0,0,7"/><PasswordBox x:Name="Confirmation" PasswordChanged="PasswordChanged" AutomationProperties.Name="Confirmar contraseña"/><TextBlock Text="Al menos 10 caracteres. No hay contraseñas predeterminadas." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/></StackPanel></StackPanel>
   <StackPanel Visibility="{Binding PreferencesStep, Converter={StaticResource BoolVisibility}}"><Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="17" Margin="0,0,0,22"><StackPanel><TextBlock Text="México · MXN" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Español (México) · importes con dos decimales" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="IVA predeterminado para nuevos productos (%)" Margin="0,0,0,7"/><TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/><TextBlock Text="Ancho del ticket (mm)" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding TicketWidths}" SelectedItem="{Binding Preferences.TicketWidthMm}" Margin="0,0,0,18"/><CheckBox Content="Usar tema oscuro" IsChecked="{Binding Preferences.DarkMode}"/><CheckBox Content="Reducir animaciones" IsChecked="{Binding Preferences.ReducedMotion}"/></StackPanel>
   <StackPanel Visibility="{Binding BackupStep, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Impresora (vacío: predeterminada de Windows)" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Preferences.PrinterName}" Margin="0,0,0,18"/><TextBlock Text="Carpeta de respaldos" Margin="0,0,0,7"/><TextBox Text="{Binding Preferences.BackupDirectory}" IsReadOnly="True" TextWrapping="Wrap"/><Button Content="Elegir carpeta" Command="{Binding BackupFolderCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,7,0,14"/><CheckBox Content="Respaldo automático cada 24 horas" IsChecked="{Binding Preferences.AutomaticBackups}"/><TextBlock Text="Se ejecuta mientras Donovan está abierto. La carpeta inicial está en esta computadora; puedes elegir una unidad externa." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,18"/><Border Background="{DynamicResource GoldSoft}" CornerRadius="9" Padding="15"><TextBlock Text="Al finalizar podrás abrir caja, registrar productos y comenzar a vender. También podrás configurar tus datos e impresora más adelante." FontSize="12"/></Border></StackPanel>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" Margin="0,20,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Atrás" Command="{Binding BackCommand}" Visibility="{Binding Setup, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanBack}" Margin="0,0,12,0"/><Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding SubmitCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinHeight="46" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/></Grid><ProgressBar Height="3" IsIndeterminate="True" Margin="0,8" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="Donovan POS Pro · 1.0" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
