<UserControl x:Class="DonovanPOS.Presentation.Views.PurchasesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Historial de compras" Command="{Binding HistoryCommand}"/><StackPanel><TextBlock Text="Proveedores y compras" Style="{StaticResource PageTitle}"/><TextBlock Text="Recibe mercancía y mantén tus costos al día." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,18,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="1. Elige al proveedor" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/><Button Content="Agregar proveedor" Command="{Binding SupplierNewCommand}" Margin="0,0,0,10"/></StackPanel><Button DockPanel.Dock="Bottom" Content="Editar proveedor" Command="{Binding SupplierChangeCommand}" Margin="0,12,0,0"/><ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="0"/></DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.1*" MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="2. Agrega la mercancía recibida" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><DockPanel Margin="0,0,0,10"><Button Content="Buscar" Command="{Binding SearchCatalogCommand}" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar producto para compra"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCatalogCommand}"/></TextBox.InputBindings></TextBox></DockPanel></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Existencia" Binding="{Binding StockLabel}" Width="110"/><DataGridTextColumn Header="Costo neto" Binding="{Binding CostCents, Converter={StaticResource Money}}" Width="105"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="12" Margin="0,10"><StackPanel><WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Cantidad" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><TextBox Text="{Binding Quantity}" Width="80"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Costo neto por unidad / presentación" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><TextBox Text="{Binding Cost}" Width="170" HorizontalAlignment="Left"/></StackPanel><Button Content="Agregar partida" Command="{Binding AddCommand}" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}"/></WrapPanel><CheckBox Content="{Binding PackLabel}" IsChecked="{Binding ByPack}" Margin="0,8,0,0"/></StackPanel></Border>
    <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"><DataGrid.Columns><DataGridTextColumn Header="Partidas de compra" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="75"/><DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="100"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="4" Margin="0,16,0,0"><Button Content="Recibir compra" Command="{Binding ReceiveCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=Total neto: {0:C2}}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Content="Quitar partida" Command="{Binding RemoveCommand}" HorizontalAlignment="Left"/></DockPanel>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
