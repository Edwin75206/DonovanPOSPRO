<UserControl x:Class="DonovanPOS.Presentation.Views.RegisterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DonovanPOS.Presentation.Common">
 <UserControl.InputBindings><KeyBinding Key="F3" Command="{Binding FindProductCommand}"/><KeyBinding Key="F6" Command="{Binding ChangeQuantityCommand}"/><KeyBinding Key="F7" Command="{Binding DiscountCommand}"/><KeyBinding Key="F8" Command="{Binding CheckoutCommand}"/><KeyBinding Key="F9" Command="{Binding QuickPriceCommand}"/><KeyBinding Key="F10" Command="{Binding SuspendCommand}"/><KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/></UserControl.InputBindings>
 <UserControl.Resources><Style x:Key="WideOnly" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding DataContext.Compact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><ControlTemplate x:Key="CompactTile" TargetType="Button"><Border Height="72" CornerRadius="7" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,7"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="23"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Grid.Row="1"><TextBlock DockPanel.Dock="Right" Text="+" Foreground="{DynamicResource Accent}" FontSize="20"/><TextBlock Text="{Binding PriceCents, Converter={StaticResource Money}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Grid></Border></ControlTemplate><Style x:Key="ProductTile" TargetType="Button"><Setter Property="Width" Value="174"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Blue}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding DataContext.Compact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Template" Value="{StaticResource CompactTile}"/><Setter Property="Width" Value="160"/></DataTrigger></Style.Triggers></Style></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Precio" ui:Icon.Glyph="&#xE8EC;" Command="{Binding QuickPriceCommand}" ToolTip="Consultar precio · F9" Margin="0,0,8,0"/><Button Content="{Binding HeldCount}" ui:Icon.Glyph="&#xE8A7;" Command="{Binding RecoverCommand}" Margin="0,0,8,0"/><Button Content="Suspender" ui:Icon.Glyph="&#xE769;" Command="{Binding SuspendCommand}" ToolTip="Guardar para después · F10"/></StackPanel><StackPanel><TextBlock Text="LISTO PARA VENDER" Style="{StaticResource WideOnly}" Foreground="{DynamicResource Accent}" Margin="0,0,0,5"/><TextBlock Text="Punto de venta" Style="{StaticResource PageTitle}"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="ENCUENTRA EL PRODUCTO" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Grid Height="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="38,12,12,12" FontSize="14" AutomationProperties.Name="Buscar producto o escanear código"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddCommand}"/></TextBox.InputBindings></TextBox><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Accent}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="Nombre, código, marca o medida…" Foreground="{DynamicResource Muted}" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBox Grid.Column="1" Text="{Binding QuantityText}" Margin="8,0,0,0" TextAlignment="Center" ToolTip="Cantidad que se agregará" AutomationProperties.Name="Cantidad a agregar"/><Button Grid.Column="2" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="Agregar producto · Enter"/></Grid></StackPanel></Border>
    <ListBox Grid.Row="1" Style="{StaticResource Pills}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,14"/>
    <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ProductTile}" Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding StockLabel}"><StackPanel><Border Background="{Binding Category, Converter={StaticResource CategoryColor}}" CornerRadius="9,9,0,0" Height="79"><Grid><ui:CategoryIcon Category="{Binding Category}" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding Sku}" FontSize="9" Margin="10,8,0,0" VerticalAlignment="Top" Foreground="#47626E"/></Grid></Border><StackPanel Margin="12,10,12,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Height="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Specification}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,10"/><DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" Width="25" Height="25" CornerRadius="6"><TextBlock Text="+" Foreground="{DynamicResource Accent}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding PriceCents, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding StockLabel}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoResults, Converter={StaticResource BoolVisibility}}"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="35" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="No encontramos ese producto" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock Text="Prueba otra palabra, clave o medida." Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Grid>
    <DockPanel Grid.Row="3" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE76B;" Style="{StaticResource IconButton}" Command="{Binding PreviousProductsCommand}" ToolTip="Página anterior" Margin="0,0,5,0"/><Button Content="&#xE76C;" Style="{StaticResource IconButton}" Command="{Binding NextProductsCommand}" ToolTip="Página siguiente"/></StackPanel><TextBlock Text="{Binding ProductCount}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="4" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="14" Margin="0,12,0,0" Visibility="{Binding HasReceipt, Converter={StaticResource BoolVisibility}}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="PDF" ui:Icon.Glyph="&#xE8A5;" Command="{Binding TicketPdfCommand}" Style="{StaticResource QuietButton}"/><Button Content="Imprimir" ui:Icon.Glyph="&#xE749;" Command="{Binding PrintCommand}" Style="{StaticResource QuietButton}"/></StackPanel><StackPanel><TextBlock Text="✓  Venta completada" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock Text="{Binding ResultText}" FontSize="10" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
   </Grid>
   <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#0C2732" CornerRadius="11,11,0,0" Padding="16,10"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Vaciar venta" Command="{Binding ClearCommand}" Style="{StaticResource IconButton}" Background="#20404B" Foreground="#B9D4DB" BorderBrush="#20404B"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" Foreground="#00CFCB" FontSize="22" Margin="0,0,10,0"/><TextBlock Text="Tu venta" Foreground="White" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="{Binding CountLabel}" Foreground="#98B7BF" Margin="12,4,0,0" FontSize="11"/></StackPanel></DockPanel><TextBlock Style="{StaticResource WideOnly}" Text="{Binding QuoteLabel}" FontSize="10" Foreground="#98B7BF" Margin="0,8,0,12"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" AutomationProperties.Name="Cliente de la venta"/></StackPanel></Border>
    <Grid Grid.Row="1" ClipToBounds="True"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15,8"><ItemsControl ItemsSource="{Binding Cart}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,11"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="Quitar producto" Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="25" MinHeight="24" Background="Transparent" BorderBrush="Transparent"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel><DockPanel Margin="0,6,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:C2}}" FontWeight="SemiBold" FontSize="16"/><TextBlock Foreground="{DynamicResource Muted}" FontSize="10"><Run Text="{Binding UnitPrice, StringFormat={}{0:C2}, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding UnitLabel, Mode=OneWay}"/></TextBlock></DockPanel><DockPanel><Button DockPanel.Dock="Right" Content="Mayoreo" Command="{Binding DataContext.WholesaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" FontSize="10" MinHeight="28" Padding="7,4" ToolTip="Alternar precio de mayoreo (administrador)"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding Wholesale}" Value="True"><Setter Property="Background" Value="{DynamicResource GoldSoft}"/><Setter Property="Foreground" Value="{DynamicResource Gold}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><StackPanel Orientation="Horizontal"><Button Content="−" Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="30" MinHeight="28" Padding="4"/><Button Content="{Binding Quantity, StringFormat={}{0:0.####}}" Command="{Binding DataContext.QuantityForCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MinWidth="50" MinHeight="28" Padding="8,4" Margin="4,0" ToolTip="Cambiar cantidad, admite fracciones por unidad"/><Button Content="+" Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="30" MinHeight="28" Padding="4"/></StackPanel></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="20"><TextBlock Style="{StaticResource WideOnly}" Text="&#xE7BF;" FontFamily="Segoe Fluent Icons" FontSize="39" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Todo listo para tu próxima venta" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,6" HorizontalAlignment="Center"/><TextBlock Text="Busca o toca un producto para comenzar." Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,11,11" Padding="16,10"><StackPanel><DockPanel Style="{StaticResource WideOnly}" Margin="0,0,0,6"><TextBlock Text="Productos · IVA incluido" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding BeforeDiscount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontSize="12"/></DockPanel><DockPanel Style="{StaticResource WideOnly}" Margin="0,0,0,7"><TextBlock DockPanel.Dock="Right" Text="{Binding DiscountAmount, StringFormat=-{0:C2}}" Foreground="{DynamicResource Accent}" FontSize="12"/><Button Content="Aplicar descuento" Command="{Binding DiscountCommand}" Style="{StaticResource QuietButton}" Padding="0,0" MinHeight="20" FontSize="11" HorizontalAlignment="Left" IsEnabled="{Binding CanDiscount}"/></DockPanel><DockPanel Margin="0,7,0,2"><TextBlock Text="Total a cobrar" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><TextBlock Text="{Binding Total, StringFormat={}{0:C2}}" FontSize="31" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><TextBlock Style="{StaticResource WideOnly}" Text="{Binding Tax, StringFormat=IVA incluido: {0:C2}}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,14"/><Button Content="Cobrar venta      F8" ui:Icon.Glyph="&#xE8C7;" Style="{StaticResource PrimaryButton}" Command="{Binding CheckoutCommand}" Height="44" FontSize="16" IsEnabled="{Binding IsEmpty, Converter={StaticResource Not}}"/><Button Content="Guardar como cotización" ui:Icon.Glyph="&#xE8A5;" Command="{Binding SaveQuoteCommand}" Style="{StaticResource QuietButton}" Margin="0,7,0,0" MinHeight="30"/></StackPanel></Border>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>




