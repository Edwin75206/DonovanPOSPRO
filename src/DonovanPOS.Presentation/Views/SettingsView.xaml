<UserControl x:Class="DonovanPOS.Presentation.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><Button Content="Guardar configuración" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/><TextBlock Text="Tu comercio, tus documentos y tus preferencias." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Datos del comercio" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Nombre comercial" Margin="0,0,0,6"/><TextBox Text="{Binding Config.StoreName}" Margin="0,0,0,14"/><TextBlock Text="Dirección" Margin="0,0,0,6"/><TextBox Text="{Binding Config.Address}" Margin="0,0,0,14"/><TextBlock Text="RFC (opcional)" Margin="0,0,0,6"/><TextBox Text="{Binding Config.TaxId}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Teléfono" Margin="0,0,0,6"/><TextBox Text="{Binding Config.Phone}" Margin="0,0,0,14"/><TextBlock Text="Correo electrónico" Margin="0,0,0,6"/><TextBox Text="{Binding Config.Email}" Margin="0,0,0,14"/><Button Content="Elegir logotipo del comercio" Command="{Binding LogoCommand}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Grid></StackPanel></Border>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Tickets, folios e impuestos" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Impresora preferida (vacío: la predeterminada)" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Config.PrinterName}" Margin="0,0,0,14"/><TextBlock Text="Ancho de ticket en milímetros" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding TicketWidths}" SelectedItem="{Binding Config.TicketWidthMm}" Margin="0,0,0,14"/><TextBlock Text="Mensaje al pie del ticket" Margin="0,0,0,6"/><TextBox Text="{Binding Config.TicketFooter}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Prefijo para nuevos folios de venta" Margin="0,0,0,6"/><TextBox Text="{Binding Config.FolioPrefix}" Margin="0,0,0,14"/><TextBlock Text="IVA predeterminado para productos nuevos (%)" Margin="0,0,0,6"/><TextBox Text="{Binding TaxPercent}" Margin="0,0,0,14"/><TextBlock Text="Los precios de venta incluyen el impuesto. Cambiar esta preferencia no modifica productos ni ventas existentes." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Grid></StackPanel></Border>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><CheckBox Content="Usar tema oscuro" IsChecked="{Binding Config.DarkMode}"/><CheckBox Content="Reducir animaciones" IsChecked="{Binding Config.ReducedMotion}"/><TextBlock Text="También respetamos la preferencia de animaciones de Windows." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Respaldos y recuperación" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><TextBlock Text="Guarda copias periódicas en una unidad diferente de esta computadora." Style="{StaticResource MutedText}" Margin="0,0,0,14"/><DockPanel><Button Content="Elegir carpeta" Command="{Binding BackupFolderCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Text="{Binding Config.BackupDirectory}" IsReadOnly="True"/></DockPanel><WrapPanel Margin="0,14,0,0"><Button Content="Crear respaldo ahora" Command="{Binding BackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><Button Content="Restaurar respaldo" Command="{Binding RestoreCommand}"/><Button Content="Ver bitácora" Command="{Binding AuditCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>
   <DockPanel Margin="0,4,0,10"><Button Content="Acerca de Donovan POS Pro" Command="{Binding AboutCommand}" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"/><StackPanel><TextBlock Text="DATOS GUARDADOS EN" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel></DockPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
