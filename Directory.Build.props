<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Donovan Systems</Company>
    <Product>Donovan POS Pro</Product>
    <Description>Punto de venta para ferretería</Description>
    <Authors>Ing. Edwin Donovan Castañeda Calderón</Authors>
    <Copyright>Copyright © 2026 Ing. Edwin Donovan Castañeda Calderón. Todos los derechos reservados sobre el código original del proyecto.</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
