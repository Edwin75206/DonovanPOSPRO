<Window x:Class="DonovanPOS.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:DonovanPOS.Presentation.ViewModels" xmlns:v="clr-namespace:DonovanPOS.Presentation.Views" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text" Title="Donovan POS Pro" Width="1360" Height="860" MinWidth="860" MinHeight="500" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DataTemplate DataType="{x:Type vm:LoginVm}"><v:WelcomeView/></DataTemplate><DataTemplate DataType="{x:Type vm:DashboardVm}"><v:OverviewView/></DataTemplate><DataTemplate DataType="{x:Type vm:PosVm}"><v:RegisterView/></DataTemplate><DataTemplate DataType="{x:Type vm:InventoryVm}"><v:StockView/></DataTemplate><DataTemplate DataType="{x:Type vm:CatalogVm}"><v:CatalogView/></DataTemplate><DataTemplate DataType="{x:Type vm:RecordsVm}"><v:RecordsView/></DataTemplate><DataTemplate DataType="{x:Type vm:PurchasesVm}"><v:PurchasesView/></DataTemplate><DataTemplate DataType="{x:Type vm:CashVm}"><v:CashView/></DataTemplate><DataTemplate DataType="{x:Type vm:ReportsVm}"><v:ReportsView/></DataTemplate><DataTemplate DataType="{x:Type vm:SettingsVm}"><v:SettingsView/></DataTemplate>
 </Window.Resources>
 <Window.InputBindings><KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="pos"/><KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="products"/></Window.InputBindings>
 <Grid Background="{DynamicResource Canvas}">
  <ContentControl Content="{Binding LoginPage}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LoggedIn}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
  <Grid Visibility="{Binding LoggedIn, Converter={StaticResource BoolVisibility}}">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Sidebar}"><DockPanel x:Name="SidebarFrame" Margin="14,22,14,16">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,16"><StackPanel Orientation="Horizontal"><Border Background="#29A8AC" CornerRadius="5" Width="32" Height="32"><TextBlock Text="D" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandLabel" Text="DONOVAN" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="BrandSub" Text="POS PRO  /  DONOVAN SYSTEMS" Foreground="#83A4AD" FontSize="9" Margin="0,10,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border x:Name="UserDetails" BorderBrush="#33505A" BorderThickness="0,1,0,0" Padding="10,16,0,12"><StackPanel><TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding RoleLabel}" Foreground="#92AFB8" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border><Button x:Name="LogoutButton" ToolTip="Cerrar sesión" Content="Cerrar sesión" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="#B4CDD4" BorderThickness="0" HorizontalContentAlignment="Left"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ListBox ItemsSource="{Binding NavigationView}" SelectedItem="{Binding SelectedNavigation}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="8" Foreground="#7098A2" Margin="12,12,0,5"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.Compact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#B9D1D7"/><Setter Property="Padding" Value="11,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#23525D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1B444F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Label}"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" TextWrapping="NoWrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></ScrollViewer>
   </DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition x:Name="TopBarRow" Height="62"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="26"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0"><DockPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="&#xE708;" FontFamily="Segoe Fluent Icons" ToolTip="Cambiar tema" Command="{Binding ThemeCommand}" Style="{StaticResource QuietButton}"/><Button Content="Historial" Command="{Binding NavigateCommand}" CommandParameter="history" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StoreName}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/><Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Margin="12,0,0,0" Padding="7,4"><TextBlock Text="LOCAL" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="9"/></Border></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="{DynamicResource AccentSoft}" Padding="20,10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Ui.Notification}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Ui.IsError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Danger}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button Content="Cerrar" Command="{Binding DismissCommand}" Style="{StaticResource QuietButton}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Ui.Notification}" VerticalAlignment="Center"/></DockPanel></Border>
    <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" Margin="24,22,24,16"/>
    <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,4"><DockPanel><TextBlock Text="MXN · Español (México)" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="F2  Punto de venta     F4  Productos     F8  Cobrar" FontSize="10" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
    <Border Grid.Row="2" Background="{DynamicResource Canvas}" Opacity="0.9" Visibility="{Binding CurrentPage.BusyVisible, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="True"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><ProgressBar Width="180" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}"/><TextBlock Text="Un momento…" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</Window>








