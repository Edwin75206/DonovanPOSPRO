<UserControl x:Class="DonovanPOS.Presentation.Views.RecordsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><DataTemplate x:Key="Action"><Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,8,6"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Primary}" Value="True"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="#0C2732"/><Setter Property="BorderBrush" Value="{DynamicResource Primary}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate><ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource Action}" ItemsPanel="{StaticResource Wrap}" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="16" Margin="0,0,0,18"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></Border>
  <DockPanel Grid.Row="2" Margin="0,0,0,14"><Button Content="Buscar / actualizar" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar en la lista" ToolTip="Buscar por nombre o folio"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/></TextBox.InputBindings></TextBox></DockPanel>
  <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0"><Grid><DataGrid x:Name="Table" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding A}" Width="1.2*" MinWidth="130"/><DataGridTextColumn Binding="{Binding B}" Width="1.3*" MinWidth="130"/><DataGridTextColumn Binding="{Binding C}" Width="*" MinWidth="110"/><DataGridTextColumn Binding="{Binding D}" Width="*" MinWidth="110"/><DataGridTextColumn Binding="{Binding E}" Width="*" MinWidth="110"/></DataGrid.Columns></DataGrid><TextBlock Text="No hay registros que coincidan. Puedes agregar uno nuevo o cambiar la búsqueda." Margin="35" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
  <ItemsControl Grid.Row="4" ItemsSource="{Binding RowActions}" ItemTemplate="{StaticResource Action}" ItemsPanel="{StaticResource Wrap}" Margin="0,16,0,0"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style></ItemsControl>
 </Grid>
</UserControl>

