<UserControl x:Class="DonovanPOS.Presentation.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DonovanPOS.Presentation.Common" xmlns:charts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Actualizar" ui:Icon.Glyph="&#xE72C;" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/><Button Content="Nueva venta" ui:Icon.Glyph="&#xE710;" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="pos" Style="{StaticResource PrimaryButton}"/></StackPanel><StackPanel><TextBlock Text="EL PULSO DE TU FERRETERÍA" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,0,0,7"/><TextBlock Text="Un buen día comienza aquí." Style="{StaticResource PageTitle}"/><TextBlock Text="Tus ventas, tu inventario y lo que sigue. Todo a la vista." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <UniformGrid Columns="4" Margin="0,0,0,18">
   <Border Background="#0C2732" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="#20464E" Width="31" Height="31" CornerRadius="8"><TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" Foreground="#00CFCB" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Ventas de hoy" Foreground="#BED5DA" FontSize="12" VerticalAlignment="Center"/></DockPanel><ui:AnimatedAmount Value="{Binding Data.TodayCents, FallbackValue=0}" FontSize="29" FontWeight="SemiBold" Foreground="White" Margin="0,9,0,11"/><TextBlock Text="{Binding Week}" Foreground="#7FE1DB" FontSize="10"/></StackPanel></Border>
   <Border Background="{DynamicResource BlueSoft}" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{DynamicResource Blue}" VerticalAlignment="Center"/><TextBlock Text="Operaciones" Foreground="{DynamicResource Blue}" FontSize="12" Height="31" VerticalAlignment="Center"/></DockPanel><ui:AnimatedAmount Value="{Binding Data.TodayCount, FallbackValue=0}" Currency="False" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,11"/><TextBlock Text="Tickets registrados hoy" Foreground="{DynamicResource Blue}" FontSize="10"/></StackPanel></Border>
   <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Text="Efectivo en caja" Foreground="{DynamicResource Accent}" FontSize="12" Height="31"/></DockPanel><ui:AnimatedAmount Value="{Binding Data.CashCents, FallbackValue=0}" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,11"/><TextBlock Text="Saldo esperado de la caja abierta" Foreground="{DynamicResource Accent}" FontSize="10"/></StackPanel></Border>
   <Border Background="{DynamicResource GoldSoft}" CornerRadius="12" Padding="18"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/><TextBlock Text="Por cobrar" Foreground="{DynamicResource Gold}" FontSize="12" Height="31"/></DockPanel><ui:AnimatedAmount Value="{Binding Data.ReceivableCents, FallbackValue=0}" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,11"/><TextBlock Text="Crédito pendiente de tus clientes" Foreground="{DynamicResource Gold}" FontSize="10"/></StackPanel></Border>
  </UniformGrid>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,16,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="7 días" Command="{Binding PeriodPresetCommand}" CommandParameter="7" Style="{StaticResource QuietButton}" MinHeight="30"/><Button Content="Este mes" Command="{Binding PeriodPresetCommand}" CommandParameter="month" MinHeight="30" Padding="12,5"/></StackPanel><StackPanel><TextBlock Text="Así van tus ventas" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ingresos del período, menos devoluciones" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <DockPanel Margin="0,15,0,7"><TextBlock Text="{Binding Period}" FontSize="28" FontWeight="SemiBold"/><Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Margin="14,5,0,5" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Comparison}" FontSize="10" Foreground="{DynamicResource Accent}"/></Border></DockPanel>
    <Grid Height="205"><charts:CartesianChart Background="{DynamicResource Surface}" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" AnimationsSpeed="{Binding AnimationSpeed}" TooltipPosition="Top"/><Border Background="{DynamicResource Surface}" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Tu siguiente historia empieza con una venta" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Aquí aparecerá el comportamiento de tu negocio." Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
    <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><WrapPanel><TextBlock Text="PERÍODO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,10,0"/><DatePicker SelectedDate="{Binding From}" Width="128" AutomationProperties.Name="Desde"/><TextBlock Text="—" Margin="8,0" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding To}" Width="128" AutomationProperties.Name="Hasta"/><Button Content="Aplicar" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></WrapPanel></Border>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="&#xEB51;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Gold}" FontSize="19"/><TextBlock Text="Los favoritos del mostrador" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="Productos con mayor importe de venta" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,18"/>
    <ItemsControl ItemsSource="{Binding Data.TopProducts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,14"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, StringFormat={}{0:C0}}" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0"/><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11"/></DockPanel><ProgressBar Height="5" Margin="0,7,0,0" Maximum="{Binding DataContext.TopMax, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{Binding Value}" Foreground="{DynamicResource Primary}" Background="{DynamicResource SurfaceAlt}" BorderThickness="0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12" Margin="0,5,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Profit}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Ganancia bruta" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Estimada · antes de gastos" Style="{StaticResource MutedText}" FontSize="9" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
   </StackPanel></Border>
  </Grid>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,16,0"><StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Ver todas" ui:Icon.Glyph="&#xE72A;" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="history" Style="{StaticResource QuietButton}" MinHeight="28"/><TextBlock Text="Actividad reciente" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><DataGrid ItemsSource="{Binding Data.Recent}" Height="240" RowHeight="40"><DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="100"/><DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Hora" Binding="{Binding CreatedAt, StringFormat=HH:mm}" Width="65"/><DataGridTextColumn Header="Total MXN" Binding="{Binding TotalCents, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource RightCell}"/></DataGrid.Columns></DataGrid><TextBlock Text="Tus primeras ventas aparecerán aquí." Foreground="{DynamicResource Muted}" Margin="0,12,0,0" Visibility="{Binding NoRecent, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><DockPanel Margin="0,0,0,15"><Button DockPanel.Dock="Right" Content="Inventario" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="inventory" Style="{StaticResource QuietButton}" MinHeight="28"/><TextBlock Text="Que no te falte" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Data.LowStock}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:CategoryIcon Category="{Binding Category}" Width="34" Height="34" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding StockLabel}" FontSize="10" Foreground="{DynamicResource Gold}" Margin="0,3,0,0"/></StackPanel><Ellipse Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource Gold}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Todo en orden. Tus productos están por encima del mínimo." Foreground="{DynamicResource Success}" Visibility="{Binding NoLowStock, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="Productos en el mínimo o por debajo de él." Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}" Margin="0,0,16,0"><StackPanel><TextBlock Text="De dónde vienen tus ventas" Style="{StaticResource SectionTitle}"/><charts:PieChart Background="{DynamicResource Surface}" Height="210" Series="{Binding CategorySeries}" LegendPosition="Right" AnimationsSpeed="{Binding AnimationSpeed}"/><TextBlock Text="Venta original por categoría · período seleccionado" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Cómo te pagan" Style="{StaticResource SectionTitle}"/><charts:PieChart Background="{DynamicResource Surface}" Height="210" Series="{Binding MethodSeries}" LegendPosition="Right" AnimationsSpeed="{Binding AnimationSpeed}"/><TextBlock Text="El crédito representa cuentas por cobrar, no efectivo recibido." Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border></Grid>
 </StackPanel></ScrollViewer>
</UserControl>

