<UserControl x:Class="DonovanPOS.Presentation.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DonovanPOS.Presentation.Common">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Recibir mercancía" ui:Icon.Glyph="&#xE896;" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="purchases" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="CADA PIEZA CUENTA" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,0,0,5"/><TextBlock Text="Tu inventario, bajo control" Style="{StaticResource PageTitle}"/><TextBlock Text="Consulta existencias, detecta faltantes y sigue cada movimiento." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18"><Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource Blue}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Productos activos" Style="{StaticResource MutedText}" FontSize="11"/><ui:AnimatedAmount Value="{Binding StockSummary.Total}" Currency="False" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></DockPanel></Border><Border Background="{DynamicResource SuccessSoft}" CornerRadius="12" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Existencia suficiente" FontSize="11" Foreground="{DynamicResource Success}"/><ui:AnimatedAmount Value="{Binding StockSummary.Available}" Currency="False" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="{DynamicResource GoldSoft}" CornerRadius="12" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Existencia baja" FontSize="11" Foreground="{DynamicResource Gold}"/><ui:AnimatedAmount Value="{Binding StockSummary.Low}" Currency="False" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="{DynamicResource DangerSoft}" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Agotados" FontSize="11" Foreground="{DynamicResource Danger}"/><ui:AnimatedAmount Value="{Binding StockSummary.OutOfStock}" Currency="False" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid>
  <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><ListBox Style="{StaticResource Pills}" ItemsSource="{Binding StockFilters}" SelectedItem="{Binding StockFilter}" VerticalAlignment="Center"/><Grid Grid.Column="1" Margin="12,0,0,0"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="36,9,12,9" AutomationProperties.Name="Buscar en inventario"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/></Grid></Grid>
  <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="16,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Exportar" ui:Icon.Glyph="&#xE898;" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}"/><Button Content="Importar" ui:Icon.Glyph="&#xE8B5;" Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="Ajustar existencia" ui:Icon.Glyph="&#xE713;" Command="{Binding AdjustCommand}" Margin="0,0,8,0"/><Button Content="Movimientos" ui:Icon.Glyph="&#xE81C;" Command="{Binding MovementsCommand}" Style="{StaticResource QuietButton}"/></StackPanel></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="64"><DataGrid.Columns><DataGridTemplateColumn Header="Producto" Width="2.4*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><ui:CategoryIcon DockPanel.Dock="Left" Category="{Binding Category}" Width="36" Height="36" Margin="0,0,11,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"><Run Text="{Binding Sku, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Specification, Mode=OneWay}"/></TextBlock></StackPanel></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*" MinWidth="100"/><DataGridTextColumn Header="Existencia" Binding="{Binding StockLabel}" Width="115"/><DataGridTextColumn Header="Mínimo" Binding="{Binding Minimum, StringFormat={}{0:0.####}}" Width="70" ElementStyle="{StaticResource RightCell}"/><DataGridTextColumn Header="Reponer" Binding="{Binding SuggestedPurchase, StringFormat={}{0:0.####}}" Width="90" ElementStyle="{StaticResource RightCell}"/><DataGridTemplateColumn Header="Estado" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:StockBadge Status="{Binding StockStatus}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Precio MXN" Binding="{Binding PriceCents, Converter={StaticResource Money}}" Width="110" ElementStyle="{StaticResource RightCell}"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2" Margin="16,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE76B;" Command="{Binding PreviousCommand}" Style="{StaticResource IconButton}" Margin="0,0,7,0" ToolTip="Página anterior"/><Button Content="&#xE76C;" Command="{Binding NextCommand}" Style="{StaticResource IconButton}" ToolTip="Página siguiente"/></StackPanel><TextBlock Text="{Binding CountLabel}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/></DockPanel></Grid></Border>
  <TextBlock Grid.Row="4" Text="Para mínimo: unidades base necesarias para alcanzar la existencia mínima configurada." Style="{StaticResource MutedText}" FontSize="10" Margin="0,10,0,0"/>
 </Grid>
</UserControl>

